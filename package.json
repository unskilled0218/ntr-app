{
  "name": "ntr",
  "private": true,
  "version": "0.15.34",
  "description": "Local-first desktop client for todo.txt tasks and a Markdown note — local files or a my-ntr-server over HTTP.",
  "author": "musty",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:task-contract": "node scripts/test-task-contract.mjs",
    "test:ha-contract": "node scripts/test-ha-contract.mjs",
    "test:release": "python3 -B -m unittest discover -s tests -p 'test_release*.py' -v",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
